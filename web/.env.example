# Base URL of the backend API (with the /api prefix).
# The Next.js dev server also proxies /api to the backend (see next.config.ts),
# so the default "/api" works locally without any env file.
NEXT_PUBLIC_API_BASE_URL="/api"

# Where the Next.js server-side proxy forwards /api and export requests.
# Must point at the Express backend, NOT at this Next app. The backend
# listens on PORT from backend/.env (default 3000).
#
# MIND THE DEV PORT: `next dev` also defaults to port 3000. Whatever starts
# second takes 3001, and the rewrite/proxy above would then hit the wrong
# server and every dashboard request would fail. Run the two on distinct
# ports, e.g.: npm run dev -- -p 3001 (web) while the backend keeps 3000,
# or set BACKEND_URL explicitly here.
BACKEND_URL="http://localhost:3000"

# Display name used in the UI shell and metadata.
NEXT_PUBLIC_APP_NAME="Attendance Platform"
