DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/attendance_db?schema=public"
PORT=3000
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-123"

# Rate limits (max requests per window)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_ATTENDANCE_MAX=10
RATE_LIMIT_EMPLOYER_WRITE_MAX=30
RATE_LIMIT_EXPORT_MAX=5

# Weekend days, comma-separated (0 = Sunday, 1 = Monday, ... 6 = Saturday).
# "5,6" = Friday and Saturday.
WEEKEND_DAYS="5,6"

TZ="Africa/Algiers"
