DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/attendance_db?schema=public"
PORT=3000
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-123"

# Rate limits (max requests per window)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_ATTENDANCE_MAX=10
RATE_LIMIT_EMPLOYER_WRITE_MAX=30
TZ="Africa/Algiers"
